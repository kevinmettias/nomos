site: tests/contract/tests/boundaries/graph.rs#Test_No_Crate_May_Name_The_Sibling_Knowledge_Workbench
site: crates/host/nomos-mcp/src/lib.rs#An MCP server over stdio
site: crates/host/nomos-mcp/tests/stdio.rs#Test_A_Real_Subprocess_Should_Answer_A_Real_Conversation_Over_Its_Own_Stdio
