{
  "suppression": {
    "max_horizon_days": 180
  },
  "naming": {
    "function": "upper-snake",
    "method": "upper-snake"
  },
  "languages": {
    "rust": {
      "naming": {
        "function": "upper-snake",
        "method": "upper-snake"
      }
    }
  },
  "scripting": {
    "tooling_language": "rust",
    "script_extensions": [],
    "forbidden_extensions": [
      ".ps1",
      ".psm1",
      ".bat",
      ".cmd",
      ".sh"
    ]
  },
  "words": {
    "approved_abbreviations": [
      "api",
      "arc",
      "bom",
      "cfg",
      "chk",
      "cli",
      "cmp",
      "db",
      "ffi",
      "html",
      "id",
      "json",
      "kwb",
      "lf",
      "mcp",
      "ms",
      "msrv",
      "nth",
      "od",
      "rc",
      "repo",
      "rs",
      "sdk",
      "sql",
      "std",
      "str",
      "ui",
      "uri",
      "url",
      "uuid",
      "vs",
      "yaml"
    ]
  },
  "json_key_naming": [
    {
      "glob": "standards.json",
      "convention": "lower-snake"
    },
    {
      "glob": "suppressions.json",
      "convention": "lower-snake"
    }
  ],
  "data_format_contracts": [
    {
      "glob": "standards.json",
      "require": [
        {
          "path": "suppression",
          "kind": "object"
        },
        {
          "path": "naming",
          "kind": "object"
        },
        {
          "path": "telemetry",
          "kind": "object"
        }
      ]
    },
    {
      "glob": "suppressions.json",
      "require": [
        {
          "path": "schema",
          "kind": "number"
        },
        {
          "path": "waivers",
          "kind": "array"
        }
      ]
    },
    {
      "glob": "work/ledger.json",
      "require": [
        {
          "path": "schema_version",
          "kind": "number"
        },
        {
          "path": "items",
          "kind": "array"
        }
      ]
    },
    {
      "glob": "packages/*.json",
      "require": [
        {
          "path": "schema_version",
          "kind": "number"
        },
        {
          "path": "package_id",
          "kind": "string"
        },
        {
          "path": "package_kind",
          "kind": "string"
        },
        {
          "path": "package_version",
          "kind": "object"
        },
        {
          "path": "protocol_range",
          "kind": "object"
        },
        {
          "path": "language_versions",
          "kind": "array"
        },
        {
          "path": "providers",
          "kind": "array"
        }
      ]
    },
    {
      "glob": "crates/spec/nomos-spec-project/profiles/*.json",
      "require": [
        {
          "path": "id",
          "kind": "string"
        },
        {
          "path": "title",
          "kind": "string"
        },
        {
          "path": "format",
          "kind": "string"
        },
        {
          "path": "output",
          "kind": "string"
        },
        {
          "path": "sections",
          "kind": "array"
        }
      ]
    },
    {
      "glob": "diagrams/*.nomos-projection.json",
      "require": [
        {
          "path": "profile",
          "kind": "string"
        },
        {
          "path": "profile_digest",
          "kind": "string"
        },
        {
          "path": "format",
          "kind": "string"
        },
        {
          "path": "output",
          "kind": "string"
        },
        {
          "path": "content_digest",
          "kind": "string"
        },
        {
          "path": "inputs_digest",
          "kind": "string"
        },
        {
          "path": "sections",
          "kind": "array"
        },
        {
          "path": "inputs",
          "kind": "array"
        }
      ]
    },
    {
      "glob": "spec/*.nomos-projection.json",
      "require": [
        {
          "path": "profile",
          "kind": "string"
        },
        {
          "path": "profile_digest",
          "kind": "string"
        },
        {
          "path": "format",
          "kind": "string"
        },
        {
          "path": "output",
          "kind": "string"
        },
        {
          "path": "content_digest",
          "kind": "string"
        },
        {
          "path": "inputs_digest",
          "kind": "string"
        },
        {
          "path": "sections",
          "kind": "array"
        },
        {
          "path": "inputs",
          "kind": "array"
        }
      ]
    }
  ],
  "standard_flags": [
    "--help"
  ],
  "projects": [
    "nomos",
    "kwb",
    "xvpe"
  ],
  "dependency_budget": {
    "max_fan_in": 225,
    "max_fan_out": 20,
    "max_area_of_effect": 37,
    "max_build_depth": 7
  },
  "tiers": [
