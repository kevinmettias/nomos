{
  "id": "subject-dossier",
  "title": "Subject dossier",
  "format": "markdown",
  "output": "subjects/{subject}/dossier.md",
  "sections": [
    {
      "title": "Subject",
      "content": "nodes",
      "filter": {
        "node_id": "{subject}"
      }
    },
    {
      "title": "Statements",
      "content": "statements",
      "filter": {
        "node_id": "{subject}"
      },
      "may_be_empty": true
    },
    {
      "title": "Relations",
      "content": "relations",
      "filter": {
        "node_id": "{subject}"
      },
      "may_be_empty": true
    }
  ]
}
